# Copy this file to .env and adjust it. See docs/hosting.md.

# Your Heroes III Complete folder, to offer the game files to the players you invite
# (they still need to own the game). Leave empty to let every player use their own files.
#   macOS / Linux:   HOMM3_DIR=/home/me/Games/HoMM 3 Complete
#   Windows:         HOMM3_DIR=C:/GOG Games/HoMM 3 Complete
HOMM3_DIR=

# Password for downloading the game files, part of the invite link (…/?key=<GAMEDATA_KEY>).
# Make up a long random one, for example with: openssl rand -hex 12
GAMEDATA_KEY=

# Port on this computer (default 8642)
PORT=8642

# Only for "docker compose --profile tunnel": the token of your Cloudflare tunnel
CLOUDFLARE_TUNNEL_TOKEN=
